# Webmention.io API Token
# Get yours from: https://webmention.io/settings
WEBMENTION_IO_TOKEN=your_token_here

# Steam API credentials
STEAM_API_KEY=your_steam_api_key
STEAM_ID=your_steam_id

# Dropper personal access token for shots imports
# Create one at: https://dropper.waylonwalker.com/auth/manage
DROPPER_TOKEN=your_dropper_pat
